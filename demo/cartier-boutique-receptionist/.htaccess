<Files "prompt.md">
  Require all denied
</Files>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /demo/cartier-boutique-receptionist/
  RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
</IfModule>
<FilesMatch "\.(js|json)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
