# Voxdonna — cache policy
# HTML must always revalidate so a deploy is never masked by a stale browser copy.
# Static assets stay long-cached; they are cache-busted via ?v= query strings.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot|jpe?g|png|gif|svg|webp|ico|mp3|mp4|json|xml)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Crawl-control files must never sit in a week-long cache: a stale sitemap
  # hides new pages from search engines until the TTL expires.
  <FilesMatch "^(sitemap.*\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Internal-only paths: stop serving business docs, scripts and data files
# publicly. 404 (not 403) so a scan doesn't even learn the path exists.
# This block runs first, before any other rewrite rule, so nothing later
# can accidentally serve or redirect one of these paths.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Internal directories, entirely off-limits. Matches "SEO VOXDONNA" as a
  # literal space or as %20 (Apache decodes REQUEST_URI, but cover both).
  # kb/ directory listing already 403s by default; this also blocks direct
  # file requests inside it (kb/<file>.md was still a public 200).
  RewriteCond %{REQUEST_URI} ^/(scripts|docs|graphify-out|kb|oracle-relay|SEO(%20|\ )VOXDONNA)/ [NC]
  RewriteRule ^ - [R=404,L]

  # Any Markdown file except a published blog post at /blog/<lang>/<slug>.md
  # (that exact path is fetched client-side by blog-post.html and must stay
  # 200). This also catches /blog/TOPIC_MAP.md, which is internal, not a post.
  RewriteCond %{REQUEST_URI} !^/blog/(en|fr|it)/[A-Za-z0-9-]+\.md$ [NC]
  RewriteRule \.md$ - [R=404,L,NC]

  # Source/data file types that should never be public, wherever they live.
  RewriteRule \.(py|pyc|sh|patch|bak[^/]*|csv|jsonl)$ - [R=404,L,NC]

  # Helper-only PHP libraries (required() by the endpoint scripts beside
  # them, never requested directly) — e.g. video-ads-lib.php. The file
  # itself also 403s if ever hit directly, so this is defense in depth.
  RewriteRule -lib\.php$ - [R=404,L,NC]
</IfModule>

# Legacy client-side renderer URLs: /blog-post.html?post=<slug>[&lang=en|fr|it].
# Every post is pre-rendered by scripts/build-blog-static.js to
# /blog/<lang>/<slug>.html, so Google's copies of the query-string form are
# duplicates; 301 them to the static page. Rules, in order:
#   1. static twin exists for (lang, slug): 301 to it. Query string dropped (the
#      trailing "?"), so utm_* and other extras do not keep the renderer alive.
#      post= and lang= may come in either order (lookaheads), lang defaults to
#      en like the renderer. The absolute apex target makes www a single hop;
#      this block therefore sits ABOVE the www rule.
#   2. the 22 posts moved to rajsuyash.com have no static file here; send them
#      to /blog/en/<slug>.html, where the block further down 301s them on.
# No twin and not moved (e.g. an en-only slug asked for as fr): no rule fires
# and the renderer still serves the page, so nothing 301s into a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} ^(?=(?:.*&)?lang=(en|fr|it)(?:&|$))(?=(?:.*&)?post=([a-z0-9-]+)(?:&|$))
  RewriteCond %{DOCUMENT_ROOT}/blog/%1/%2.html -f
  RewriteRule ^blog-post\.html$ https://voxdonna.com/blog/%1/%2.html? [R=301,L]
  RewriteCond %{QUERY_STRING} ^(?!(?:.*&)?lang=)(?=(?:.*&)?post=([a-z0-9-]+)(?:&|$))
  RewriteCond %{DOCUMENT_ROOT}/blog/en/%1.html -f
  RewriteRule ^blog-post\.html$ https://voxdonna.com/blog/en/%1.html? [R=301,L]
  RewriteCond %{QUERY_STRING} (?:^|&)post=(ai-pilot-to-production-playbook|first-ai-project-how-to-choose|ai-total-cost-ownership-framework|hidden-costs-ai-automation|why-ai-projects-fail-postmortems|ai-governance-policy-template-smb|customer-service-automation-maturity-model|ai-customer-service-benchmarks-2026|generative-ai-enterprise-spending-analysis|agentic-ai-enterprise-2027-outlook|ai-workforce-planning-automation|ai-integration-legacy-systems|ai-automation-vs-rpa-difference|ai-tools-small-business-guide|ai-adoption-roadmap-midsize-business|ai-readiness-assessment-checklist|ai-automation-roi-calculation-guide|build-vs-buy-ai-automation|ai-implementation-mistakes-executives|ai-vendor-evaluation-scorecard|state-of-ai-adoption-2026-research-roundup|ai-productivity-paradox-2026)(?:&|$)
  RewriteRule ^blog-post\.html$ https://voxdonna.com/blog/en/%1.html? [R=301,L]
</IfModule>

# One hostname only. Google had indexed www copies while every canonical tag,
# the sitemap and all internal links point at the apex, so the two hosts were
# competing and the apex pages sat undiscovered.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.voxdonna\.com$ [NC]
  RewriteRule ^(.*)$ https://voxdonna.com/$1 [R=301,L]
</IfModule>

# Some demos are a folder with an index, and the rest are single .html files, so
# /demo/<name>.html is a reasonable guess that used to 404. Send it to the folder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{DOCUMENT_ROOT}/demo/$1/index.html -f
  RewriteRule ^demo/([A-Za-z0-9_-]+)\.html$ /demo/$1/ [R=301,L]
</IfModule>

# Renamed pages
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^hermes-assistant\.html$ /personal-assistant.html [R=301,L]
  # ai-for-sap.html merged into the manufacturers industry page (2026-09-18).
  RewriteRule ^ai-for-sap\.html$ /ai-for-manufacturers.html [R=301,L]
  # Elections moved to aisewak.com, the government/citizen-services site of the same
  # group, which already ranks for the query. Two sites competing on one intent is
  # how both stay invisible. (2026-09-18)
  RewriteRule ^election-campaign-manager\.html$ https://aisewak.com/ai-voice-agent-for-elections [R=301,L]
</IfModule>

# 22 AI-strategy posts moved to rajsuyash.com, the founder's site, which now
# owns that intent. Two sites competing on one topic is how both stay
# invisible. All three language copies retire to the one English target.
# The blog-post.html rules above send the legacy ?post=<slug> form of these
# slugs to /blog/en/<slug>.html, which these rules then 301 to rajsuyash.com.
# (2026-09-19)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^blog/(en|fr|it)/ai-pilot-to-production-playbook\.html$ https://rajsuyash.com/blog/ai-pilot-to-production-guide.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/first-ai-project-how-to-choose\.html$ https://rajsuyash.com/blog/how-to-choose-your-first-ai-project.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-total-cost-ownership-framework\.html$ https://rajsuyash.com/blog/ai-automation-total-cost-of-ownership.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/hidden-costs-ai-automation\.html$ https://rajsuyash.com/blog/hidden-costs-of-ai-automation.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/why-ai-projects-fail-postmortems\.html$ https://rajsuyash.com/blog/why-ai-projects-fail.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-governance-policy-template-smb\.html$ https://rajsuyash.com/blog/ai-automation-governance-policy-smb.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/customer-service-automation-maturity-model\.html$ https://rajsuyash.com/blog/customer-service-automation-maturity-model.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-customer-service-benchmarks-2026\.html$ https://rajsuyash.com/blog/ai-customer-service-benchmarks-2026.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/generative-ai-enterprise-spending-analysis\.html$ https://rajsuyash.com/blog/enterprise-ai-budget-spending-2026.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/agentic-ai-enterprise-2027-outlook\.html$ https://rajsuyash.com/blog/agentic-ai-enterprise-2027.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-workforce-planning-automation\.html$ https://rajsuyash.com/blog/ai-automation-workforce-planning.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-integration-legacy-systems\.html$ https://rajsuyash.com/blog/ai-integration-legacy-systems.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-automation-vs-rpa-difference\.html$ https://rajsuyash.com/blog/ai-automation-vs-rpa.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-tools-small-business-guide\.html$ https://rajsuyash.com/blog/ai-tools-for-small-business.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-adoption-roadmap-midsize-business\.html$ https://rajsuyash.com/blog/ai-automation-implementation-roadmap.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-readiness-assessment-checklist\.html$ https://rajsuyash.com/blog/business-ready-for-ai.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-automation-roi-calculation-guide\.html$ https://rajsuyash.com/blog/how-to-measure-ai-automation-roi.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/build-vs-buy-ai-automation\.html$ https://rajsuyash.com/blog/ai-automation-build-vs-buy-vs-outsource.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-implementation-mistakes-executives\.html$ https://rajsuyash.com/blog/ai-automation-mistakes-smbs.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-vendor-evaluation-scorecard\.html$ https://rajsuyash.com/blog/how-to-evaluate-ai-automation-tools.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/state-of-ai-adoption-2026-research-roundup\.html$ https://rajsuyash.com/blog/ai-automation-statistics-2026.html [R=301,L]
  RewriteRule ^blog/(en|fr|it)/ai-productivity-paradox-2026\.html$ https://rajsuyash.com/blog/ai-productivity-paradox-2026.html [R=301,L]
